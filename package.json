{
  "name": "isometric-world",
  "private": true,
  "type": "module",
  "workspaces": [
    "pipeline",
    "web"
  ],
  "scripts": {
    "fetch": "npm -w pipeline run fetch --",
    "scene": "npm -w pipeline run scene --",
    "ground": "npm -w pipeline run ground --",
    "render": "npm -w pipeline run render --",
    "paint": "npm -w pipeline run paint --",
    "export": "npm -w pipeline run export --",
    "og": "npm -w pipeline run og --",
    "dev": "npm -w web run dev",
    "build": "npm -w web run build",
    "typecheck": "npm -w pipeline run typecheck && npm -w web run astro -- check",
    "publish": "npm -w pipeline run publish --",
    "deploy": "npm run build && npm -w pipeline exec tsx src/deploy.ts"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
