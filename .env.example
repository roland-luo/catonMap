# Optional local settings. Copy to .env (never committed); the pipeline loads it.

# Hosting (required for dev, build, export, publish, deploy).
# Public origin of the R2 bucket (its custom domain), e.g. https://tiles.example.com
TILES_ORIGIN=
# Cloudflare account that owns the bucket and the Worker (Workers & Pages → Account ID)
CLOUDFLARE_ACCOUNT_ID=
# Domain the site is deployed to by `npm run deploy`, e.g. maps.example.com
SITE_DOMAIN=

# R2 write token for `npm run publish` (Cloudflare → R2 → Manage API tokens, Object Read & Write on the
# bucket). Without it, publish uses your wrangler login (`npx wrangler login`).
CLOUDFLARE_API_TOKEN=

# Chromium used by the renderer and the test scripts (default /usr/bin/chromium), and its launch flags
# (default --enable-gpu; e.g. add --use-angle=vulkan or --use-gl=egl for your GPU backend).
CHROME_PATH=
CHROME_ARGS=

# The running site the test and film scripts open when no URL is passed (the dev server prints its port).
SITE_URL=http://localhost:<port>/

# Optional: browser AK of the Baidu Maps basemap (?basemap=baidu). Baidu's console binds an AK to
# referer domains — add localhost and the site's domain there. Without it the page stays on the
# painted isometric map.
PUBLIC_BAIDU_AK=
